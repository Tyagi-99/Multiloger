{
  "description": "Professional multi-profile Chromium platform for managing client browser environments",
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "multiloger",
  "packageManager": "pnpm@9.15.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "type": "module",
  "version": "0.1.0"
}

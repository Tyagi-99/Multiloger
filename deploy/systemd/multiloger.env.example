# Copy to /etc/multiloger/multiloger.env, chmod 600, chown root:root.
# Generate keys with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Prefer the _FILE variants below over inline values where your setup allows it.

# Encrypts .mlbackup files (AES-256-GCM). Lose it → backups are unrecoverable.
MULTILOGER_BACKUP_KEY=<64-hex-chars>
# MULTILOGER_BACKUP_KEY_FILE=/etc/multiloger/backup.key   # 0600 file holding the hex key (alternative)

# Encrypts the proxy-credential vault file (AES-256-GCM). Lose it → vault secrets are unrecoverable.
MULTILOGER_VAULT_KEY=<64-hex-chars>
# MULTILOGER_VAULT_KEY_FILE=/etc/multiloger/vault.key     # 0600 file holding the hex key (alternative)

# Where the API stores the SQLite DB, profile dirs, backups, and vault file.
MULTILOGER_DATA_DIR=/var/lib/multiloger/data

# Optional overrides (defaults shown):
# MULTILOGER_HOST=127.0.0.1
# MULTILOGER_PORT=3000
# MULTILOGER_CHROMIUM_PATH=/usr/bin/chromium
# MULTILOGER_HEADLESS=true
